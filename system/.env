# Live HRMIS procurement database — the app's primary database. Login
# accounts, purchase orders, notifications and the audit trail all live
# here; this app has no local database (see getPoDB() in config.php).
PO_DB_HOST=192.168.11.70
PO_DB_NAME=purchase_request
PO_DB_USER=piodsky
PO_DB_PASS=Tenshi07!
PO_DB_CHARSET=utf8mb4

# HRMIS platform's shared personnel database (same server, different schema
# than purchase_request above) — read-only lookups only (Settings > HRMIS
# Users); see getHrmisDB() in config.php. Never used for this app's own login.
HRMIS_DB_HOST=192.168.11.70
HRMIS_DB_NAME=hrmis
HRMIS_DB_USER=piodsky
HRMIS_DB_PASS=Tenshi07!
HRMIS_DB_CHARSET=utf8mb4




APP_NAME=CGM Logistics System
APP_FULL_NAME=City Government of Malaybalay Logistics System

# Local development only. 1 puts PHP errors and database connection details
# back on screen — leave this blank/0 on any deployed instance.
APP_DEBUG=0

# Key for the encrypted verification token inside each printed PO's QR code
# (AES-256-GCM, see poVerifyToken() in config.php). 64 hex chars = 256 bits.
#
# CHANGING THIS INVALIDATES EVERY QR CODE ALREADY PRINTED — previously issued
# tokens will no longer decrypt and those printouts will fail verification.
# Treat it like a password: keep it out of version control and off shared docs.
QR_SECRET=599b1bd4c862e901403e8b104756ba7ab359a908137b1222cfd4f44362d437c9

# Optional. Fixed public base URL baked into printed QR codes. Left blank, the
# URL is derived from whichever host the print was generated from — which means
# printing while browsing at "localhost" produces QRs no phone can open.
APP_URL=http://192.168.10.234/SystemsMISPYO/CGMLogistics/system

# Document Tracking System (TAS) — read-only, owned by another team.
# Same server as the others; tasviewer is a dedicated read-only login.
TASDB_DB_HOST=192.168.10.254
TASDB_DB_NAME=tasdb
TASDB_DB_USER=tasviewer
TASDB_DB_PASS=taspass
TASDB_DB_CHARSET=utf8mb4
